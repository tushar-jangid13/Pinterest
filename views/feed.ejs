<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pinterest Feed</title>
  <link rel="stylesheet" href="/stylesheets/feed.css">
  <link rel="stylesheet" href="/stylesheets/sidebar.css">
</head>
<body class="with-sidebar">

  <%- include('partials/sidebar', { activePage }) %>

  <!-- Search bar and profile button -->
  <div class="page">
    <header class="topbar">
      <div class="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
        <input type="search" placeholder="Search for ideas">
        <button class="search-tool" type="button" title="Search with an image" aria-label="Search with an image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/><circle cx="12" cy="12" r="3.5"/><path d="M17 7h.01"/></svg>
        </button>
        <button class="search-tool mic" type="button" title="Voice search" aria-label="Voice search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M9 21h6"/></svg>
        </button>
      </div>

      <a class="profile-menu" href="/profile" title="Your profile">
        <span class="avatar">
          <% if (user.dp) { %>
            <img src="<%= user.dp %>" alt="<%= user.username %>'s profile photo">
          <% } else { %>
            <%= user.username.charAt(0).toUpperCase() %>
          <% } %>
        </span>
      </a>
    </header>

    <!-- Feed content -->
    <main class="content">
      <div class="feed-tabs">
        <a class="tab active" href="/feed">All</a>
      </div>

      <!-- Copy a pin-card to add another image -->
      <section class="pin-grid">
        <article class="pin-card">
          <a class="pin-image" href="#">
            <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=700&q=85" alt="Silver sports car">
            <span class="save-button">Save</span>
          </a>
        </article>

        <article class="pin-card">
          <a class="pin-image" href="#">
            <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=700&q=85" alt="Classic car detail">
            <span class="save-button">Save</span>
            <span class="image-label">Last visited</span>
          </a>
        </article>

        <article class="pin-card">
          <a class="pin-image" href="#">
            <img src="https://images.unsplash.com/photo-1502877338535-766e1452684a?auto=format&fit=crop&w=700&q=85" alt="Yellow sports car">
            <span class="save-button">Save</span>
          </a>
